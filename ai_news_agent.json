    {
      "parameters": {
        "jsCode": "// HTML7 və HTML8 node-larından bütün məlumatları götür\nconst html7items = $('HTML7').all();\nconst html8items = $('HTML8').all();\n\n// İki array uzunluqları fərqli ola bilər, minimum uzunluq qədər işləyək\nconst length = Math.min(html7items.length, html8items.length);\n\nconst results = [];\n\nfor (let i = 0; i < length; i++) {\n  const h7 = html7items[i].json;\n  const h8 = html8items[i].json;\n\n  // Title, Link, Content HTML7-dən\n  const title = h7.Title || `Xəbər ${i + 1}`;\n  const link = h7.Link ? `https://sonxeber.az${h7.Link}` : 'https://sonxeber.az/';\n  \n  const rawContent = h7.Content || [];\n  const joinedContent = Array.isArray(rawContent) ? rawContent.join('\\n') : String(rawContent);\n  const cleanedContent = joinedContent.trim();\n\n  // Photo URL HTML8 Content hissəsindən çıxarılır\n  const h8Content = h8.Content || [];\n  const h8JoinedContent = Array.isArray(h8Content) ? h8Content.join('\\n') : String(h8Content);\n  \n  const photoMatch = h8JoinedContent.match(/\\[\\/Uploads\\/[^\\]]+\\.(jpg|png|jpeg|webp)\\]/i);\n  const photoUrl = photoMatch ? `https://sonxeber.az${photoMatch[0].replace('[', '').replace(']', '')}` : null;\n\n  results.push({\n    json: {\n      ID: `news_${i + 1}_${Date.now()}`,\n      Title: title,\n      Link: link,\n      Photo: photoUrl\n    }\n  });\n}\n\nreturn results; "
      },
