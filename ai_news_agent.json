      "parameters": {
        "jsCode": "// Get current date (Baku time assumed via system)\nconst now = new Date();\n\nconst day = String(now.getDate()).padStart(2, '0');\nconst month = String(now.getMonth() + 1).padStart(2, '0');\nconst year = now.getFullYear();\n\nconst formattedDate = `${day}.${month}.${year}`;\n\n// Get items (xeberler)\nconst newsItems = items; // 'Get row(s) in sheet1' node-dan gələn item-lar\n\nconst total = newsItems.length;\n\nlet report = `📰 Community Report (${formattedDate})\\n`;\nreport += `Bu gün ${total} xəbər paylaşıldı:\\n\\n`;\n\nnewsItems.forEach((item, index) => {\n  const title = item.json.Title || 'Başlıq yoxdur';\n  const link = item.json.Link || 'Link yoxdur';\n\n  report += `${index + 1}. ${title}\\n${link}\\n\\n`;\n});\n\nreturn [\n  {\n    json: {\n      report: report.trim()\n    }\n  }\n];\n"
      },
